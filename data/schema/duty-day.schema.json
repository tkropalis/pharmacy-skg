{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "uploadedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "When the file appeared at the URL"
              }
            },
            "required": [
              "url",
              "uploadedAt"
            ],
            "additionalProperties": false
          },
          "sections": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "day",
                    "saturday-extra",
                    "on-duty",
                    "overnight",
                    "after-midnight"
                  ]
                },
                "heading": {
                  "type": "string",
                  "description": "As printed"
                },
                "hours": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        "toNextDay": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "from",
                        "to",
                        "toNextDay"
                      ],
                      "additionalProperties": false,
                      "description": "Local time (Europe/Athens). toNextDay: ends after midnight, including at 00:00."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "From the heading; null when it states none"
                },
                "extraHours": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "weekdays": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 7
                        },
                        "description": "ISO weekdays, 1 = Monday"
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "exceptHolidays": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "weekdays",
                      "from",
                      "to",
                      "exceptHolidays"
                    ],
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "entries": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pharmacyId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "As printed in the ΦΣΘ list"
                      },
                      "address": {
                        "type": "string"
                      },
                      "locality": {
                        "type": "string",
                        "minLength": 1
                      },
                      "phone": {
                        "type": "string",
                        "description": "As printed; normally 10 digits"
                      }
                    },
                    "required": [
                      "pharmacyId",
                      "name",
                      "address",
                      "locality",
                      "phone"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "kind",
                "heading",
                "hours",
                "extraHours",
                "notes",
                "entries"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "sections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "groups"
  ],
  "additionalProperties": false
}
