{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the prices or shortages last changed"
    },
    "bulletins": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+\\/\\d+$",
            "description": "<article id>/<file id> on moh.gov.gr"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prescription",
              "otc"
            ],
            "description": "otc: non-prescription (ΜΗΣΥΦΑ), indicative prices"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The announcement's title, as published"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "The announcement's date"
          },
          "articleUrl": {
            "type": "string",
            "format": "uri"
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          },
          "fileUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "date",
          "articleUrl",
          "fileName",
          "fileUrl"
        ],
        "additionalProperties": false
      },
      "description": "Applied oldest first"
    },
    "shortageList": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "The date the list is as of"
            },
            "postUrl": {
              "type": "string",
              "format": "uri"
            },
            "fileUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "title",
            "date",
            "postUrl",
            "fileUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "medicines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "barcode": {
            "type": "string",
            "pattern": "^\\d{13}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name, form, strength and pack, as printed"
          },
          "atc": {
            "type": "string"
          },
          "substance": {
            "type": "string",
            "description": "Active substances, comma-separated"
          },
          "company": {
            "type": "string",
            "description": "Marketing authorisation holder"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.01,
            "description": "Retail price in euros with VAT: a maximum, or indicative when otc"
          },
          "otc": {
            "type": "boolean"
          },
          "notReimbursed": {
            "type": "boolean",
            "description": "Flagged \"Μη αποζημιούμενο\" in the bulletin"
          },
          "bulletin": {
            "type": "string",
            "description": "The PriceBulletin id that set the price"
          },
          "shortage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "from": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "to": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Expected end, as printed; null when blank"
                  },
                  "reason": {
                    "type": "string",
                    "description": "As printed"
                  }
                },
                "required": [
                  "from",
                  "to",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "On the latest ΕΟΦ limited-availability list"
          }
        },
        "required": [
          "barcode",
          "name",
          "atc",
          "substance",
          "company",
          "price",
          "otc",
          "notReimbursed",
          "bulletin",
          "shortage"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "bulletins",
    "shortageList",
    "medicines"
  ],
  "additionalProperties": false
}
