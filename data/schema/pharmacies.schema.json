{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "pharmacies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(\\d{10}|x-[0-9a-f]{10})$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "postcode": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{10}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "groupId": {
            "description": "ΦΣΘ area group; null if never seen in a duty list",
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "override",
                      "overture",
                      "nominatim"
                    ]
                  },
                  "precision": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "street",
                      "locality"
                    ],
                    "description": "exact: the building or the pharmacy itself; street/locality: approximate"
                  },
                  "ref": {
                    "description": "Id or query in the source, for tracing",
                    "type": "string"
                  }
                },
                "required": [
                  "lat",
                  "lon",
                  "source",
                  "precision"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fsth",
                "pkm"
              ]
            }
          },
          "firstSeen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lastSeen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "locality",
          "postcode",
          "phone",
          "groupId",
          "location",
          "sources",
          "firstSeen",
          "lastSeen"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "pharmacies"
  ],
  "additionalProperties": false
}
