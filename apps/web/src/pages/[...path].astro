---
import type { GetStaticPaths } from 'astro';
import type { Locale } from '@pharmacy-skg/core';
import AboutPage from '../components/pages/AboutPage.astro';
import HomePage from '../components/pages/HomePage.astro';
import PrivacyPage from '../components/pages/PrivacyPage.astro';
import ReportPage from '../components/pages/ReportPage.astro';
import Base from '../layouts/Base.astro';
import { allPathParams, t } from '../i18n/index.ts';
import type { RouteKey } from '../i18n/index.ts';

// One template for every page in every locale: the Greek and English slugs are listed in
// i18n/routes.ts, so the language switcher and hreflang links cannot drift from the files.
export const getStaticPaths = (() =>
  allPathParams().map(({ path, locale, route }) => ({
    params: { path },
    props: { locale, route },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const d = t(locale);
const meta = {
  home: { title: d.home.title, description: d.home.description },
  about: { title: d.about.title, description: d.about.description },
  privacy: { title: d.privacy.title, description: d.privacy.description },
  report: { title: d.report.title, description: d.report.description },
}[route];
---

<Base locale={locale} route={route} title={meta.title} description={meta.description}>
  {route === 'home' && <HomePage locale={locale} />}
  {route === 'about' && <AboutPage locale={locale} />}
  {route === 'privacy' && <PrivacyPage locale={locale} />}
  {route === 'report' && <ReportPage locale={locale} />}
</Base>
