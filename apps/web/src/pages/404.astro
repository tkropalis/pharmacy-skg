---
import Base from '../layouts/Base.astro';
import { localizedPath, t } from '../i18n/index.ts';

// Vercel serves one 404 for every address, so this page is bilingual: Greek first, then English.
// The title says it all; `body` is only the meta description.
const el = t('el').notFound;
const en = t('en').notFound;
---

<Base locale="el" route={null} title={el.title} description={el.body}>
  <div class="container prose">
    <h1>{el.title}</h1>
    <p>
      <a class="button" href={localizedPath('el', 'home')}>
        {el.homeLink}
      </a>
    </p>

    <div lang="en">
      <h2>{en.title}</h2>
      <p>
        <a href={localizedPath('en', 'home')}>{en.homeLink}</a>
      </p>
    </div>
  </div>
</Base>
