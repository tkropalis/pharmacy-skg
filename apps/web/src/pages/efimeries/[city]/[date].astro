---
import DutyDatePage from '../../components/seo/DutyDatePage.astro';
import { loadSeoModel } from '../../lib/seo/site-data.ts';

export async function getStaticPaths() {
  const model = await loadSeoModel();
  return model.publishedDates.map((date) => ({ params: { date } }));
}

const { date } = Astro.params;
---

<DutyDatePage locale="el" date={date ?? ''} />
