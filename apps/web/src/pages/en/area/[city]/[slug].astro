---
import AreaPage from '../../../components/seo/AreaPage.astro';
import { loadSeoModel } from '../../../lib/seo/site-data.ts';

export async function getStaticPaths() {
  const model = await loadSeoModel();
  return model.areas.map((area) => ({ params: { slug: area.slug } }));
}

const { slug } = Astro.params;
---

<AreaPage locale="en" slug={slug ?? ''} />
