---
import PharmacyPage from '../../../components/seo/PharmacyPage.astro';
import { loadSeoModels } from '../../../lib/seo/site-data.ts';

export async function getStaticPaths() {
  const models = await loadSeoModels();
  return models.flatMap((model) =>
    model.pharmacies.map((pharmacy) => ({
      params: { id: pharmacy.id },
      props: { cityId: model.cityId },
    })),
  );
}

const { id } = Astro.params;
const { cityId } = Astro.props;
---

<PharmacyPage locale="en" cityId={cityId} id={id ?? ''} />
