---
import { faPlus } from '@fortawesome/free-solid-svg-icons';
import type { Locale } from '@pharmacy-skg/core';
import { faSvg } from '../../lib/fa.ts';
import { t } from '../../i18n/index.ts';
import { dutyIndexPath } from '../../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).home;
const app = t(locale).app;
// The page carries nothing that depends on the date or on the data (a rebuild must not change
// it, or every data update would create a new service worker version): the link goes to the
// list of dates, and the interactive app that replaces this content works out today itself.
const dutyHref = dutyIndexPath(locale);
---

<!--
  #app holds the content that works without JavaScript (the title and a link to the duty lists).
  scripts/home-app.tsx replaces it with the map and the list. It is mounted from a bundled
  module script, not an Astro island, because islands emit inline scripts that the site's
  Content-Security-Policy (vercel.json, script-src 'self') forbids.
-->
<div
  id="app"
  class="app-region"
  role="region"
  aria-label={app.regionLabel}
  data-locale={locale}
  data-title={d.title}
  data-text={JSON.stringify(app)}
>
  <div class="container fallback">
    <span class="cross" set:html={faSvg(faPlus, { size: 28 })} />
    <h1>{d.title}</h1>
    <noscript>
      <p>{d.noScript}</p>
    </noscript>
    <p>
      <a class="button" href={dutyHref}>
        {d.dutyLink}
      </a>
    </p>
  </div>
</div>

<script>
  import '../../scripts/home-app.tsx';
</script>

<style>
  /* The page is an app viewport (global.css): the region fills what the bars leave. */
  .app-region {
    flex: 1 1 0;
    min-height: 0;
    overflow: auto;
  }

  .fallback {
    padding-block: 2.5rem;
  }

  .cross {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.25rem;
    border-radius: 0.875rem;
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
