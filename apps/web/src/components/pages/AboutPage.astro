---
import type { Locale } from '@pharmacy-skg/core';
import { CONTACT_EMAIL, REPO_URL } from '../../config.ts';
import { localizedPath, t } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).about;
const searchCredits = t(locale).search.credits;

const creditLinks: Record<keyof typeof d.credits, string> = {
  fsth: 'https://www.thess.guide/',
  pkm: 'https://www.pkm.gov.gr/',
  overture: 'https://overturemaps.org/',
  osm: 'https://www.openstreetmap.org/copyright',
  openFreeMap: 'https://openfreemap.org/',
  fontAwesome: 'https://fontawesome.com/license/free',
  manrope: 'https://github.com/sharanda/manrope',
};

const searchCreditLinks: Record<keyof typeof searchCredits, string> = {
  moh: 'https://www.moh.gov.gr/articles/times-farmakwn/deltia-timwn',
  eof: 'https://www.eof.gr/category/farmaka/eparkeia-farmaka/',
};
const allCredits = [
  ...(Object.keys(d.credits) as (keyof typeof d.credits)[]).map((id) => ({
    text: d.credits[id],
    url: creditLinks[id],
  })),
  ...(Object.keys(searchCredits) as (keyof typeof searchCredits)[]).map((id) => ({
    text: searchCredits[id],
    url: searchCreditLinks[id],
  })),
];
---

<div class="container prose">
  <h1>{d.title}</h1>
  <p class="lead">{d.disclaimer}</p>

  {d.sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </section>
  ))}

  <section>
    <h2>{d.emergencyHeading}</h2>
    <p>{d.emergencyBody}</p>
  </section>

  <section id="credits">
    <h2>{d.creditsHeading}</h2>
    <ul class="credits">
      {allCredits.map(({ text, url }) => (
        <li>
          {text}{' '}
          <a href={url} rel="noopener">
            {new URL(url).hostname.replace(/^www\./, '')}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <p>
    {d.contact} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </p>

  <p class="muted">
    {d.sourceBody}{' '}
    <a href={REPO_URL} rel="noopener">
      GitHub
    </a>
    . <a href={localizedPath(locale, 'report')}>{d.reportCta}</a>
  </p>
</div>

<style>
  .lead {
    font-weight: 600;
  }

  .credits {
    padding-inline-start: 1.25rem;
    font-size: 0.9375rem;
  }

  .credits li + li {
    margin-top: 0.25rem;
  }
</style>
