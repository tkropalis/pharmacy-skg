---
import type { Locale } from '@pharmacy-skg/core';
import { LOCALES } from '@pharmacy-skg/core';
import { alternatePaths, t } from '../i18n/index.ts';
import type { RouteKey } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /** The page being shown; the switcher links to the same page in the other locale. */
  route: RouteKey;
  /** Explicit per-locale paths for generated pages (pharmacy, duty date, area). */
  alternates?: Record<Locale, string> | undefined;
}

const { locale, route, alternates } = Astro.props;
const paths = alternates ?? alternatePaths(route);
const others = LOCALES.filter((l) => l !== locale);
---

<nav class="switcher" aria-label={t(locale).languageSwitcherLabel}>
  <ul>
    {others.map((other) => (
      <li>
        <a href={paths[other]} lang={other} hreflang={other} aria-label={t(other).localeName}>
          <span class="pill" aria-hidden="true">
            {t(other).localeName}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<!--
  The language's own name in full, on a phone too ("English", "Ελληνικά"): a visitor who does not
  read Greek looks for a word, and a two-letter code in small grey type was easy to miss. The
  link's accessible name is the same name (WCAG 2.5.3). The link keeps a 44x44 px target while
  the visible pill is slimmer, so the header bar stays low.
-->
<style>
  .switcher {
    flex: none;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--fg);
    text-decoration: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 1.75rem;
    padding-inline: 0.5rem;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font-weight: 650;
    font-size: 0.8125rem;
  }

  a:hover .pill {
    border-color: var(--accent);
  }

  @media (min-width: 40rem) {
    .pill {
      min-height: 2.25rem;
      padding-inline: 0.875rem;
      font-size: 0.875rem;
    }
  }
</style>
