---
import type { Locale } from '@pharmacy-skg/core';
import { LOCALES } from '@pharmacy-skg/core';
import { alternatePaths, t } from '../i18n/index.ts';
import type { RouteKey } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /** The page being shown; the switcher links to the same page in the other locale. */
  route: RouteKey;
  /** Explicit per-locale paths for generated pages (pharmacy, duty date, area). */
  alternates?: Record<Locale, string> | undefined;
}

const { locale, route, alternates } = Astro.props;
const paths = alternates ?? alternatePaths(route);
const others = LOCALES.filter((l) => l !== locale);
---

<nav class="switcher" aria-label={t(locale).languageSwitcherLabel}>
  <ul>
    {others.map((other) => (
      <li>
        <a href={paths[other]} lang={other} hreflang={other} aria-label={t(other).localeName}>
          <span class="pill" aria-hidden="true">
            <span class="code">{t(other).localeCode}</span>
            <span class="full">{t(other).localeName}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<!--
  A phone shows a two-letter code ("EN", "ΕΛ"); the link's accessible name is the language's
  own name, which contains the visible text (WCAG 2.5.3). The link keeps a 44x44 px target
  while the visible pill is slimmer, so the header bar stays low.
-->
<style>
  .switcher {
    flex: none;
  }

  ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--fg);
    text-decoration: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 1.75rem;
    padding-inline: 0.5rem;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .full {
    display: none;
  }

  a:hover .pill {
    border-color: var(--accent);
  }

  @media (min-width: 40rem) {
    .code {
      display: none;
    }

    .full {
      display: inline;
    }

    .pill {
      min-height: 2.25rem;
      padding-inline: 0.875rem;
      color: var(--fg);
      font-size: 0.875rem;
      letter-spacing: 0;
    }
  }
</style>
