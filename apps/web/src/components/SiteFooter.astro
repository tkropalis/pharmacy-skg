---
import type { Locale } from '@pharmacy-skg/core';
import { localizedPath, t } from '../i18n/index.ts';
import { areaIndexPath, dutyIndexPath } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).footer;
const seo = t(locale).seo;
const about = localizedPath(locale, 'about');

const links = [
  { href: about, label: d.aboutShort },
  { href: localizedPath(locale, 'privacy'), label: d.privacy },
  { href: localizedPath(locale, 'report'), label: d.report },
  { href: dutyIndexPath(locale), label: seo.footerDuty },
  { href: areaIndexPath(locale), label: seo.footerArea },
];
---

<!--
  Compact: a row of links, one freshness line, one credits line (every source is named, the
  About page holds the full list with the licences) and the disclaimer. The home screen has
  no page footer; its sheet carries a shorter one (components/app/HomeApp.tsx).
-->
<footer class="site-footer">
  <div class="container">
    <nav aria-label={d.navLabel}>
      <ul class="links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="small">
      <strong>{d.lastUpdatedLabel}</strong> <time data-updated-at>—</time>
    </p>
    <p class="small muted">
      {d.creditsLine}
      {' · '}
      <a href={`${about}#credits`}>{d.creditsMore}</a>
    </p>
    <p class="small muted disclaimer">{d.disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    flex: none;
    margin-top: 1.5rem;
    padding-block: 0.25rem calc(1rem + var(--safe-b));
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.875rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.8125rem;
  }

  @media (min-width: 40rem) {
    .links a {
      font-size: 0.875rem;
    }
  }

  .small {
    margin: 0 0 0.25rem;
    line-height: 1.45;
  }

  .small a {
    white-space: nowrap;
  }
</style>
