---
import type { Locale } from '@pharmacy-skg/core';
import { REPO_URL } from '../config.ts';
import { formatUpdatedAt } from '../lib/freshness.ts';
import { buildMeta } from '../lib/meta.ts';
import { localizedPath, t } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).footer;
type SourceId = keyof typeof d.sourceNotes;

function creditName(source: (typeof buildMeta.sources)[number]): string {
  return source.name[locale] ?? source.name.en ?? source.name.el ?? source.id;
}

function creditNote(source: (typeof buildMeta.sources)[number]): string | undefined {
  return d.sourceNotes[source.id as SourceId] ?? source.note;
}

// Credits that are not in meta.json: the re-hosting site and the map stack.
const extraCredits = [
  { name: 'thess.guide', note: d.thessGuideNote, url: 'https://www.thess.guide/' },
];
const mapCredits = [
  { name: 'OpenFreeMap', note: d.openFreeMapNote, url: 'https://openfreemap.org/' },
  { name: 'OpenMapTiles', note: d.openMapTilesNote, url: 'https://openmaptiles.org/' },
  {
    name: 'OpenStreetMap',
    note: d.openStreetMapNote,
    url: 'https://www.openstreetmap.org/copyright',
  },
];
---

<footer class="site-footer">
  <div class="container">
    <p class="freshness">
      <strong>{d.lastUpdatedLabel}</strong>{' '}
      <time data-updated-at datetime={buildMeta.updatedAt}>
        {formatUpdatedAt(buildMeta.updatedAt, locale)}
      </time>
    </p>

    <p class="disclaimer">{d.disclaimer}</p>

    <nav aria-label={d.navLabel}>
      <ul class="links">
        <li>
          <a href={localizedPath(locale, 'about')}>{d.about}</a>
        </li>
        <li>
          <a href={localizedPath(locale, 'privacy')}>{d.privacy}</a>
        </li>
        <li>
          <a href={localizedPath(locale, 'report')}>{d.report}</a>
        </li>
        <li>
          <a href={REPO_URL} rel="noopener">
            {d.sourceCode}
          </a>
        </li>
      </ul>
    </nav>

    <div class="credits">
      <h2>{d.sourcesHeading}</h2>
      <ul>
        {buildMeta.sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener">
              {creditName(source)}
            </a>
            {creditNote(source) !== undefined && <span class="muted"> — {creditNote(source)}</span>}
          </li>
        ))}
        {extraCredits.map((credit) => (
          <li>
            <a href={credit.url} rel="noopener">
              {credit.name}
            </a>
            <span class="muted"> — {credit.note}</span>
          </li>
        ))}
      </ul>
      <h2>{d.mapHeading}</h2>
      <ul>
        {mapCredits.map((credit) => (
          <li>
            <a href={credit.url} rel="noopener">
              {credit.name}
            </a>
            <span class="muted"> — {credit.note}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="muted tagline">{t(locale).tagline}</p>
  </div>
</footer>

<style>
  .site-footer {
    flex: none;
    margin-top: 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.9375rem;
  }

  .freshness {
    margin-bottom: 0.25rem;
  }

  .links,
  .credits ul {
    margin: 0 0 var(--space);
    padding: 0;
    list-style: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .links a {
    display: inline-block;
    padding-block: 0.5rem;
  }

  .credits li {
    padding-block: 0.125rem;
  }

  .credits h2 {
    margin: 1rem 0 0.25rem;
    font-size: 1rem;
  }

  .tagline {
    margin: 0;
  }
</style>
