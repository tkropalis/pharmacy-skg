---
import type { Locale } from '@pharmacy-skg/core';
import { localizedPath, t } from '../i18n/index.ts';
import { areaIndexPath, dutyIndexPath } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).footer;
const seo = t(locale).seo;
const theme = t(locale).app.footer.theme;
const choices = ['light', 'dark', 'auto'] as const;
const about = localizedPath(locale, 'about');

const links = [
  { href: about, label: d.aboutShort },
  { href: localizedPath(locale, 'privacy'), label: d.privacy },
  { href: localizedPath(locale, 'report'), label: d.report },
  { href: dutyIndexPath(locale), label: seo.footerDuty },
  { href: areaIndexPath(locale), label: seo.footerArea },
];
---

<!--
  Compact: a row of links, one line with the data's age and the disclaimer, and the choice of
  light or dark. The sources are on the About page. The home screen has no page footer; its
  sheet carries its own (components/app/HomeApp.tsx).
-->
<footer class="site-footer">
  <div class="container">
    <nav aria-label={d.navLabel}>
      <ul class="links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="small muted">
      <span class="updated">
        {d.lastUpdatedLabel} <time data-updated-at></time>
        {' · '}
      </span>
      {d.disclaimer}
    </p>

    <!-- Light, dark or auto (public/theme.js). Shown by scripts/boot.ts: it needs JavaScript. -->
    <div class="theme" data-theme-control hidden>
      <span id="theme-label" class="muted">
        {theme.label}
      </span>
      <div class="choices" role="group" aria-labelledby="theme-label">
        {choices.map((choice) => (
          <button type="button" data-choice={choice} aria-pressed="false">
            {theme[choice]}
          </button>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    flex: none;
    margin-top: 1.5rem;
    padding-block: 0.25rem calc(1rem + var(--safe-b));
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.875rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.8125rem;
  }

  @media (min-width: 40rem) {
    .links a {
      font-size: 0.875rem;
    }
  }

  .small {
    margin: 0 0 0.25rem;
    line-height: 1.45;
  }

  .theme {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem 0.75rem;
    margin: 0.5rem 0 0.25rem;
  }

  .theme[hidden] {
    display: none;
  }

  /* A soft track; the chosen option is a white thumb (as the home screen's controls). */
  .choices {
    display: inline-grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    padding: 0.1875rem;
    border-radius: 999px;
    background: var(--soft);
  }

  .choices button {
    min-height: 2.375rem;
    padding: 0.25rem 0.875rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .choices button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--fg);
    box-shadow:
      0 1px 2px rgb(20 40 30 / 0.12),
      0 2px 6px rgb(20 40 30 / 0.08);
  }

  /* The date is filled in by scripts/boot.ts; until then (or without JavaScript) no label. */
  .updated:has(time:empty) {
    display: none;
  }
</style>
