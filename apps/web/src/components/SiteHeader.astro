---
import { faMagnifyingGlass, faPlus } from '@fortawesome/free-solid-svg-icons';
import type { Locale } from '@pharmacy-skg/core';
import { APP_HEADER_NAME, APP_NAME } from '../config.ts';
import { localizedPath, t } from '../i18n/index.ts';
import type { RouteKey } from '../i18n/index.ts';
import { faSvg } from '../lib/fa.ts';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  /** null on pages without a counterpart (404): the switcher then links to the home pages. */
  route: RouteKey | null;
  /** Explicit per-locale paths for generated pages that have no RouteKey. */
  alternates?: Record<Locale, string> | undefined;
}

const { locale, route, alternates } = Astro.props;
const search = t(locale).search;
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={localizedPath(locale, 'home')}>
      <span class="logo" set:html={faSvg(faPlus, { size: 12 })} />
      <span class="name short">{APP_HEADER_NAME[locale]}</span>
      <span class="name long">{APP_NAME[locale]}</span>
    </a>
    <div class="tools">
      <button
        type="button"
        class="search"
        data-medicine-search
        aria-label={search.openLabel}
        aria-haspopup="dialog"
      >
        <span class="search-pill">
          <span set:html={faSvg(faMagnifyingGlass, { size: 13 })} />
          <span>{search.open}</span>
        </span>
      </button>
      <LanguageSwitcher locale={locale} route={route ?? 'home'} alternates={alternates} />
    </div>
    <noscript>
      <style>
        [data-medicine-search] {
          display: none !important;
        }
      </style>
    </noscript>
  </div>
</header>

<style>
  /* The top of the page: it reaches under a status bar or notch (viewport-fit=cover). */
  .site-header {
    position: relative;
    z-index: 10;
    padding-top: var(--safe-t);
    background: var(--surface);
    box-shadow: 0 1px 0 var(--border);
  }

  /* One 44px row: the logo and name, the medicine search and the language switch. */
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
  }

  .brand {
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.75rem;
    color: var(--fg);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .long {
    display: none;
  }

  .logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    background: var(--accent);
    color: var(--on-accent);
  }

  .tools {
    display: flex;
    flex: none;
    align-items: center;
  }

  /*
   * The medicine search (scripts/medicine-search.ts): a 44px target around a small pill, like the
   * language switch. It needs JavaScript, so the noscript style hides it without; it is in the
   * page from the start, so nothing moves when the script runs.
   */
  .search {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--accent-ink);
    font: inherit;
    cursor: pointer;
  }

  .search-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    min-height: 1.75rem;
    padding-inline: 0.625rem;
    border-radius: 999px;
    background: var(--accent-soft);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .search:hover .search-pill {
    background: color-mix(in srgb, var(--accent-soft), var(--accent) 12%);
  }

  .search[aria-busy='true'] {
    cursor: progress;
  }

  @media (min-width: 40rem) {
    .inner {
      gap: 0.75rem;
      padding-block: 0.25rem;
    }

    .short {
      display: none;
    }

    .long {
      display: inline;
    }

    .brand {
      font-size: 1rem;
    }

    .logo {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 0.5rem;
    }

    .search-pill {
      min-height: 2.25rem;
      padding-inline: 0.875rem;
      font-size: 0.875rem;
    }
  }
</style>
