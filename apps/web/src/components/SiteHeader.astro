---
import type { Locale } from '@pharmacy-skg/core';
import { APP_NAME } from '../config.ts';
import { localizedPath, t } from '../i18n/index.ts';
import type { RouteKey } from '../i18n/index.ts';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  /** null on pages without a counterpart (404): the switcher then links to the home pages. */
  route: RouteKey | null;
}

const { locale, route } = Astro.props;
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={localizedPath(locale, 'home')} aria-label={t(locale).homeLinkLabel}>
      <svg class="logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect width="32" height="32" rx="6"></rect>
        <path d="M13 6h6v7h7v6h-7v7h-6v-7H6v-6h7z"></path>
      </svg>
      <span class="name">{APP_NAME[locale]}</span>
    </a>
    <LanguageSwitcher locale={locale} route={route ?? 'home'} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--fg);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .logo {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .logo rect {
    fill: var(--accent);
  }

  .logo path {
    fill: var(--on-accent);
  }
</style>
