---
import { faMagnifyingGlass, faPlus } from '@fortawesome/free-solid-svg-icons';
import type { Locale } from '@pharmacy-skg/core';
import { APP_HEADER_NAME, APP_NAME } from '../config.ts';
import { localizedPath, t } from '../i18n/index.ts';
import type { RouteKey } from '../i18n/index.ts';
import { faSvg } from '../lib/fa.ts';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  /** null on pages without a counterpart (404): the switcher then links to the home pages. */
  route: RouteKey | null;
  /** Explicit per-locale paths for generated pages that have no RouteKey. */
  alternates?: Record<Locale, string> | undefined;
}

const { locale, route, alternates } = Astro.props;
const search = t(locale).search;
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={localizedPath(locale, 'home')}>
      <span class="logo" set:html={faSvg(faPlus, { size: 14 })} />
      <span class="name short">{APP_HEADER_NAME[locale]}</span>
      <span class="name long">{APP_NAME[locale]}</span>
    </a>
    <div class="tools">
      <button
        type="button"
        class="search"
        data-medicine-search
        aria-label={search.openLabel}
        aria-haspopup="dialog"
      >
        <span set:html={faSvg(faMagnifyingGlass, { size: 16 })} />
        <span>{search.open}</span>
      </button>
      <LanguageSwitcher locale={locale} route={route ?? 'home'} alternates={alternates} />
    </div>
    <noscript>
      <style>
        [data-medicine-search] {
          display: none !important;
        }
      </style>
    </noscript>
  </div>
</header>

<style>
  /* The top of the page: it reaches under a status bar or notch (viewport-fit=cover). */
  .site-header {
    position: relative;
    z-index: 10;
    padding-top: var(--safe-t);
    background: var(--surface);
    box-shadow: 0 1px 0 var(--border);
  }

  /* One 44px row on a phone: the logo, the short name and the language switch. */
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .brand {
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.75rem;
    color: var(--fg);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .long {
    display: none;
  }

  .tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
  }

  /*
   * The medicine search (scripts/medicine-search.ts). It needs JavaScript, so the noscript style
   * hides it without; it is in the page from the start, so nothing moves when the script runs.
   */
  .search {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
  }

  .search:hover {
    background: var(--surface);
  }

  .search[aria-busy='true'] {
    cursor: progress;
  }

  .logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (min-width: 40rem) {
    .inner {
      gap: 1rem;
      padding-block: 0.375rem;
    }

    .short {
      display: none;
    }

    .long {
      display: inline;
    }

    .brand {
      gap: 0.625rem;
      font-size: 1.0625rem;
    }

    .logo {
      width: 2rem;
      height: 2rem;
      border-radius: 0.625rem;
    }
  }
</style>
