---
import type { Locale } from '@pharmacy-skg/core';
import { EMERGENCY_NUMBERS } from '../config.ts';
import { t } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).emergency;

// 166 and 112 are Greek national numbers; the Poison Centre is a regular landline.
const numbers = [
  { name: d.ambulance, display: EMERGENCY_NUMBERS.ambulance },
  { name: d.europe, display: EMERGENCY_NUMBERS.europe },
  { name: d.poison, display: EMERGENCY_NUMBERS.poison },
];
---

<!--
  One compact line on a phone: the label and the three numbers, each a tel: link of at least
  44px height. The names show from 40rem up; on a phone they are in the accessible name
  ("ΕΚΑΒ 166", which contains the visible number).
-->
<aside class="emergency" aria-label={d.label}>
  <div class="container inner">
    <strong class="label">
      <span class="long">{d.label}:</span>
      <span class="short" aria-hidden="true">
        {d.labelShort}
      </span>
    </strong>
    <ul>
      {numbers.map((n) => (
        <li>
          <a href={`tel:${n.display.replace(/\s/g, '')}`} aria-label={`${n.name} ${n.display}`}>
            <span class="name">{n.name}</span> <strong>{n.display}</strong>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .emergency {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--emergency-bg);
    color: var(--emergency-fg);
    font-size: 0.875rem;
    line-height: 1.2;
    /* The strip reaches under a status bar / notch when the page is shown edge to edge. */
    padding-top: var(--safe-t);
  }

  /* One line normally. With large text it wraps, and the measured height (src/scripts/boot.ts)
     keeps the room reserved for the sticky strip right. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.25rem;
    min-height: 2.75rem;
    padding-inline: max(0.75rem, var(--safe-l)) max(0.75rem, var(--safe-r));
  }

  .label {
    flex: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    flex: 1 1 auto;
    justify-content: space-evenly;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.375rem;
    color: inherit;
    text-decoration: underline;
    white-space: nowrap;
  }

  /* The full label and the names make the strip too long for a small phone. */
  .long {
    display: none;
  }

  @media (min-width: 24rem) {
    .long {
      display: inline;
    }

    .short {
      display: none;
    }
  }

  .name {
    display: none;
  }

  a:focus-visible {
    outline-color: #ffffff;
    outline-offset: -3px;
  }

  @media (min-width: 40rem) {
    .emergency {
      font-size: 0.9375rem;
    }

    .inner {
      gap: 0 0.75rem;
      padding-inline: max(var(--space), var(--safe-l)) max(var(--space), var(--safe-r));
    }

    ul {
      flex: 0 1 auto;
      justify-content: flex-start;
      gap: 0.5rem;
    }

    a {
      padding-inline: 0.5rem;
    }
  }

  /* The names make the label and the three links one line only on a wide screen; the strip
     is wider than the text column there so they fit (and stay one line, not two). */
  @media (min-width: 54rem) {
    .inner {
      max-width: 64rem;
    }

    .name {
      display: inline;
    }
  }
</style>
