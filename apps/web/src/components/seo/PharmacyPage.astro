---
import {
  faCircleInfo,
  faDiamondTurnRight,
  faMapLocationDot,
  faPhone,
} from '@fortawesome/free-solid-svg-icons';
import type { Locale } from '@pharmacy-skg/core';
import { SITE_URL } from '../../config.ts';
import { t } from '../../i18n/index.ts';
import { faSvg } from '../../lib/fa.ts';
import { loadSeoModel } from '../../lib/seo/site-data.ts';
import { pharmacyPageProps } from '../../lib/seo/views.ts';
import PharmacyDutyList from './PharmacyDutyList.astro';
import SeoLayout from './SeoLayout.astro';

interface Props {
  locale: Locale;
  cityId: string;
  id: string;
}

const { locale, cityId, id } = Astro.props;
const model = await loadSeoModel(cityId);
const origin = (Astro.site ?? new URL(SITE_URL)).origin;
const page = pharmacyPageProps(model, locale, id, origin);
if (page === null) throw new Error(`No pharmacy with id ${id}`);

const d = t(locale);
const seo = d.seo.pharmacy;
const row = d.app.row;
// The name people say leads; the registered one follows only where it differs. On an English
// page the Greek name and address share one line: they are what is on the sign.
const under =
  page.nativeName !== null
    ? [page.nativeName, page.nativeAddress].filter(Boolean).join(', ')
    : page.name !== page.shortName
      ? page.name
      : null;
// Where the regular hours are not known (decision D26) the app shows who is on duty.
const dutyOnly = page.regularHours === null;
---

<!--
  What a person arriving from a search came for, in order: is it open, call, how to get there.
  Then what to do when it is closed: the nearest open ones and one button into the app. Then the
  hours. Nothing else: the sources are on the about page and the data's age is in the footer.
-->
<SeoLayout
  meta={page.meta}
  jsonLd={page.jsonLd}
  updated={{ at: page.updatedAt, text: page.updatedAtText }}
>
  {page.map !== null && (
    <section
      slot="hero"
      class="seo-hero"
      aria-label={seo.mapHeading}
      data-pharmacy-map
      data-lat={page.map.lat}
      data-lon={page.map.lon}
      data-approximate={page.map.approximate ? 'true' : undefined}
    >
      <div class="seo-map-canvas" data-map-canvas aria-hidden="true"></div>
      <a class="seo-map-link" href={page.mapPath}>
        <Fragment set:html={faSvg(faMapLocationDot)} />
        {seo.mapOpen}
      </a>
      {/* The licences ask for this; one tap away, as on the home screen's map. */}
      <details class="seo-map-credit">
        <summary aria-label={seo.mapCredits}>
          <Fragment set:html={faSvg(faCircleInfo, { size: 14 })} />
        </summary>
        <p>
          <a href="https://openfreemap.org" rel="noopener">
            OpenFreeMap
          </a>{' '}
          <a href="https://www.openmaptiles.org/" rel="noopener">
            © OpenMapTiles
          </a>{' '}
          <a href="https://www.openstreetmap.org/copyright" rel="noopener">
            © OpenStreetMap
          </a>
        </p>
      </details>
    </section>
  )}

  <h1>{page.shortName}</h1>
  <p class="seo-place">
    {page.address},{' '}
    {page.areaPagePath === null ? (
      page.localityLabel
    ) : (
      <a href={page.areaPagePath}>{page.localityLabel}</a>
    )}
    {page.postcode !== null && <> {page.postcode}</>}
  </p>
  {under !== null && (
    <p class="seo-native" lang={page.nativeName !== null ? 'el' : undefined}>
      {under}
    </p>
  )}
  {page.map === null && <p class="seo-native">{row.noLocation}</p>}
  {page.map?.approximate === true && <p class="seo-native">{row.approximate}</p>}

  <section aria-labelledby="status-heading">
    <h2 id="status-heading" class="sr-only">
      {seo.statusHeading}
    </h2>
    <!-- Worked out in the browser (scripts/seo/pharmacy-page.ts); empty without JavaScript. -->
    <div
      class="seo-now"
      role="status"
      aria-live="polite"
      data-pharmacy-status
      data-pharmacy-id={page.id}
      data-city={model.cityId}
    ></div>
  </section>

  <ul class="seo-actions">
    {page.callText !== null && page.phoneHref !== null && (
      <li>
        <a class="button" href={page.phoneHref} data-call>
          <Fragment set:html={faSvg(faPhone)} />
          {page.callText}
        </a>
      </li>
    )}
    <li>
      <a
        class="button secondary"
        href={page.directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-directions
      >
        <Fragment set:html={faSvg(faDiamondTurnRight)} />
        {seo.directions}
      </a>
    </li>
  </ul>
  {page.callText === null && <p class="seo-meta">{seo.noPhone}</p>}

  {page.nearby.length > 0 && (
    <section aria-labelledby="near-heading">
      <h2 id="near-heading" data-near-heading>
        {seo.nearHeading}
      </h2>
      <ul class="seo-near" data-near-list>
        {page.nearby.map((near) => (
          <li data-pharmacy-id={near.id}>
            <div class="seo-near-text">
              <a class="name" href={near.path}>
                {near.name}
              </a>
              <span class="state" data-state></span>
              <span class="sub">
                {near.distanceText !== null && `${near.distanceText} · `}
                {near.place}
              </span>
            </div>
            {near.phoneHref !== null && (
              <a class="seo-call" href={near.phoneHref} aria-label={near.callLabel}>
                <Fragment set:html={faSvg(faPhone)} />
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- The way into the app: green when this pharmacy is closed, quiet while Call leads. -->
  <p class="seo-app">
    <a class="button secondary" href={page.mapPath} data-app-link>
      <Fragment set:html={faSvg(faMapLocationDot)} />
      {dutyOnly ? seo.nearDutyCta : seo.nearCta}
    </a>
  </p>

  <section aria-labelledby="hours-heading">
    <h2 id="hours-heading">{seo.hoursHeading}</h2>
    <!-- The coming days, from the engine, replace the general hours below. -->
    <ol class="seo-week" data-week hidden></ol>
    <div data-hours-static>
      <h3>{seo.regularLabel}</h3>
      {page.regularHours === null ? (
        <p>{seo.regularUnknown}</p>
      ) : (
        <ul class="seo-hours">
          {page.regularHours.groups.map((group) => (
            <li>
              {group.days} {group.times}
            </li>
          ))}
        </ul>
      )}
      {page.regularClosedText !== null && <p class="seo-meta">{page.regularClosedText}</p>}
      {page.extendedHours.length > 0 && (
        <>
          <h3>{seo.extendedHeading}</h3>
          {page.extendedHours.map((entry) => (
            <>
              <ul class="seo-hours">
                {entry.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              <p class="seo-meta">
                {entry.periodText}.{' '}
                <a href={entry.announcementUrl} rel="noopener">
                  {seo.extendedAnnouncement}
                </a>
              </p>
            </>
          ))}
        </>
      )}
    </div>
  </section>

  {page.upcomingDuties.length > 0 && (
    <section aria-labelledby="duty-heading">
      <h2 id="duty-heading">{seo.dutyHeading}</h2>
      <PharmacyDutyList locale={locale} items={page.upcomingDuties} />
    </section>
  )}

  <p class="seo-report">
    <a href={page.reportPath}>{seo.reportLink}</a>
  </p>
</SeoLayout>

<script>
  import '../../scripts/seo/pharmacy-page.ts';
</script>
