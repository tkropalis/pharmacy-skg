---
import type { Locale } from '@pharmacy-skg/core';
import { SITE_URL } from '../../config.ts';
import { loadSeoModel } from '../../lib/seo/site-data.ts';
import { breadcrumbJsonLd, jsonLdScript } from '../../lib/seo/jsonld.ts';
import { dutyPageProps } from '../../lib/seo/views.ts';
import DutyDayContent from './DutyDayContent.astro';
import SeoLayout from './SeoLayout.astro';

interface Props {
  locale: Locale;
  cityId: string;
  date: string;
}

const { locale, cityId, date } = Astro.props;
const model = await loadSeoModel(cityId);
const page = dutyPageProps(model, locale, date);
if (page === null) throw new Error(`No published duty list for ${cityId} ${date}`);
const origin = (Astro.site ?? new URL(SITE_URL)).origin;
---

<SeoLayout
  meta={page.meta}
  jsonLd={jsonLdScript(breadcrumbJsonLd(page.breadcrumbs, origin))}
  updated={{ at: page.updatedAt, text: page.updatedAtText }}
>
  <DutyDayContent locale={locale} page={page} />
</SeoLayout>

<script>
  import '../../scripts/seo/today.ts';
</script>
