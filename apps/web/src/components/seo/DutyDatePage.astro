---
import { faCircleInfo, faMapLocationDot } from '@fortawesome/free-solid-svg-icons';
import type { Locale } from '@pharmacy-skg/core';
import { SITE_URL } from '../../config.ts';
import { t } from '../../i18n/index.ts';
import { faSvg } from '../../lib/fa.ts';
import { loadSeoModel } from '../../lib/seo/site-data.ts';
import { breadcrumbJsonLd, jsonLdScript } from '../../lib/seo/jsonld.ts';
import { dutyPageProps } from '../../lib/seo/views.ts';
import DutyDayContent from './DutyDayContent.astro';
import SeoLayout from './SeoLayout.astro';

interface Props {
  locale: Locale;
  cityId: string;
  date: string;
}

const { locale, cityId, date } = Astro.props;
const model = await loadSeoModel(cityId);
const page = dutyPageProps(model, locale, date);
if (page === null) throw new Error(`No published duty list for ${cityId} ${date}`);
const origin = (Astro.site ?? new URL(SITE_URL)).origin;
const pharmacy = t(locale).seo.pharmacy;
const located = page.groups.some((group) =>
  group.sections.some((section) => section.entries.some((entry) => entry.location !== null)),
);
---

<SeoLayout
  meta={page.meta}
  jsonLd={jsonLdScript(breadcrumbJsonLd(page.breadcrumbs, origin))}
  updated={{ at: page.updatedAt, text: page.updatedAtText }}
>
  {/* The day's pharmacies on duty, as on a pharmacy's page: a picture that opens the home map. */}
  {located && (
    <section slot="hero" class="seo-hero" aria-label={pharmacy.mapHeading} data-duty-map>
      <div class="seo-map-canvas" data-map-canvas aria-hidden="true"></div>
      <a class="seo-map-link" href={page.mapPath}>
        <Fragment set:html={faSvg(faMapLocationDot)} />
        {pharmacy.mapOpen}
      </a>
      <details class="seo-map-credit">
        <summary aria-label={pharmacy.mapCredits}>
          <Fragment set:html={faSvg(faCircleInfo, { size: 14 })} />
        </summary>
        <p>
          <a href="https://openfreemap.org" rel="noopener">
            OpenFreeMap
          </a>{' '}
          <a href="https://www.openmaptiles.org/" rel="noopener">
            © OpenMapTiles
          </a>{' '}
          <a href="https://www.openstreetmap.org/copyright" rel="noopener">
            © OpenStreetMap
          </a>
        </p>
      </details>
    </section>
  )}
  <DutyDayContent locale={locale} page={page} />
</SeoLayout>

<script>
  import '../../scripts/seo/today.ts';
  import '../../scripts/seo/duty-page.ts';
</script>
