---
import type { Locale } from '@pharmacy-skg/core';
import { SITE_URL } from '../../config.ts';
import { t } from '../../i18n/index.ts';
import Base from '../../layouts/Base.astro';
import { cityDataUrl } from '../../lib/data.ts';
import { breadcrumbJsonLd, jsonLdScript } from '../../lib/seo/jsonld.ts';
import { loadSeoModel } from '../../lib/seo/site-data.ts';
import { areaPageProps } from '../../lib/seo/views.ts';
import HomePage from '../pages/HomePage.astro';
import '../../styles/seo.css';

interface Props {
  locale: Locale;
  cityId: string;
  slug: string;
}

const { locale, cityId, slug } = Astro.props;
const model = await loadSeoModel(cityId);
const page = areaPageProps(model, locale, slug);
if (page === null) throw new Error(`No area with slug ${slug}`);
const origin = (Astro.site ?? new URL(SITE_URL)).origin;

const d = t(locale);
const seo = d.seo.area;
---

<!--
  An area's page ('/perioxi/kilkis/polykastro/'), where people arrive from a search: the app
  itself, opened on this area as if it had been chosen, like a city's page for today
  (DutyTodayPage). Until it has loaded (and for search engines and browsers without JavaScript)
  the page is the area's published duties and its pharmacies.
-->
<Base
  locale={locale}
  route={null}
  title={page.meta.title}
  description={page.meta.description}
  alternates={page.meta.alternates}
  app
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={jsonLdScript(breadcrumbJsonLd(page.breadcrumbs, origin))}
  />
  {['meta.json', 'pharmacies.json'].map((file) => (
    <link
      slot="head"
      rel="preload"
      as="fetch"
      href={cityDataUrl(cityId, file)}
      crossorigin="anonymous"
    />
  ))}
  <HomePage locale={locale} cityId={cityId} area={page.locality} title={page.h1}>
    <div class="container seo-page">
      <nav class="seo-breadcrumb" aria-label={d.seo.breadcrumbLabel}>
        <ol>
          <li>
            <a href={page.indexPath}>{seo.allAreas}</a>
          </li>
          <li aria-current="page">{page.label}</li>
        </ol>
      </nav>

      <h1>{page.h1}</h1>

      <section aria-labelledby="duty-heading">
        <h2 id="duty-heading">{seo.dutyHeading}</h2>
        {page.dutyDays.length === 0 ? (
          <p>{seo.dutyNone}</p>
        ) : (
          <ul class="seo-list">
            {page.dutyDays.map((day) => (
              <li>
                <span class="name">
                  <a href={day.pagePath}>{day.dateLabel}</a>
                </span>
                {day.items.map((item) => (
                  <span class="sub">
                    {item.pharmacyPath !== null ? (
                      <a href={item.pharmacyPath}>{item.pharmacyName}</a>
                    ) : (
                      item.pharmacyName
                    )}
                    {' · '}
                    {item.kindLabel}
                  </span>
                ))}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-labelledby="list-heading">
        <h2 id="list-heading">{seo.listHeading}</h2>
        <ul class="seo-list">
          {page.pharmacies.map((pharmacy) => (
            <li>
              <span class="name">
                <a href={pharmacy.path}>{pharmacy.name}</a>
              </span>
              <span class="sub">{pharmacy.address}</span>
              {pharmacy.phoneHref !== null && (
                <span class="sub">
                  <a href={pharmacy.phoneHref}>{pharmacy.phone}</a>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </HomePage>
</Base>
