---
import type { Locale } from '@pharmacy-skg/core';
import { t } from '../../i18n/index.ts';
import type { PharmacyDutyView } from '../../lib/seo/views.ts';

interface Props {
  locale: Locale;
  items: readonly PharmacyDutyView[];
}

const { locale, items } = Astro.props;
const seo = t(locale).seo;
---

<!--
  One line per duty, as in the home screen's favourites: the date (a link to that day's lists),
  the kind and the hours. "Τρί 6 Οκτ · Νυχτερινή εφημερία · 21:00–00:00 · Επίσης: 14:00–17:00".
-->
<ul class="seo-list">
  {items.map((item) => (
    <li>
      {item.pagePath !== null ? (
        <a href={item.pagePath}>
          <time datetime={item.date}>{item.dateLabel}</time>
        </a>
      ) : (
        <time datetime={item.date}>{item.dateLabel}</time>
      )}
      {' · '}
      {item.kindLabel}
      {' · '}
      {item.hoursText}
      {item.extraHours.map((extra) => (
        <>
          {' · '}
          {seo.duty.extraHoursLabel} {extra}
        </>
      ))}
    </li>
  ))}
</ul>
